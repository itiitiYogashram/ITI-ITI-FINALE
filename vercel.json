{
  "framework": null,
  "buildCommand": "npm run build",
  "nodeVersion": "22.x",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "itiitiyogashram.vercel.app"
        }
      ],
      "destination": "https://itiitiyogashram.com/:path*",
      "permanent": true
    }
  ]
}
